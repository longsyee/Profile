# PostgreSQL connection string for the portfolio API and private editor.
DATABASE_URL=postgresql://postgres:password@localhost:5432/edwin_portfolio

# Used only by `npm run admin:create`; never expose these as VITE_ variables.
ADMIN_EMAIL=edwin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional editor safeguards. Defaults: 10 failed-capable attempts per 15 min,
# 10 MiB per image, 512 MiB and 500 files total in assets/uploads.
LOGIN_RATE_LIMIT_ATTEMPTS=10
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=536870912
UPLOAD_MAX_FILES=500
